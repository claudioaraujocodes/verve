<div class="min-h-[70vh] flex items-center justify-center">
    
    <div class="bg-white p-8 shadow-md border border-gray-200 mx-4 mt-4 w-full max-w-md">
        <div class="flex flex-col items-center text-center mb-6">
            <div class="w-[70px]">
                <img src="/logo-verve-no-slg.png" alt="logo verve">
            </div>
           
            <p class="text-sm text-gray-500 mt-1">Insira suas credenciais para acessar o painel de controle.</p>
        </div>

        {{#if error}}
            <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm font-medium">
                {{error}}
            </div>
        {{/if}}

        <form action="/admin/login" method="POST" class="space-y-4 ">
            <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Usuário</label>
                <input type="text" name="username" required autocomplete="off"
                       class="w-full px-3 py-2 border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-gray-50 text-gray-900">
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Senha</label>
                <input type="password" name="password" required
                       class="w-full px-3 py-2 border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-gray-50 text-gray-900">
            </div>

            <button type="submit" 
                    class="w-full bg-[#8A9A5B] text-white font-medium py-2.5 hover:bg-[#4C5532] transition-colors shadow-sm">
                Entrar no Painel
            </button>
        </form>
    </div>
</div>