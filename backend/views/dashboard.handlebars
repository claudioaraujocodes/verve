<div class="flex flex-col w-full  items-center ">



    <div class=" bg-[#93a06c] flex w-[100%] px-4">

        <div class="flex flex-row w-[100%] justify-center">

            <div class="flex flex-row justify-end gap-4 py-3 w-[100%] max-w-7xl">

                <a href="/admin/exportar-excel" class="text-white bg-[#5c6442] hover:bg-[#4c523d] w-[75px] h-7 items-center justify-center
                cursor-pointer text-xs flex font-bold rounded-sm ">
                    Exportar
                </a>


                <form action="/admin/logout" method="get">
                    <input type="submit" value="Sair" class="text-white  bg-[#5c6442]  hover:bg-[#4c523d]
                w-[75px] h-7 items-center justify-center cursor-pointer text-xs font-bold rounded-sm ">
                </form>

            </div>

        </div>
    </div>



    <div class="flex flex-col w-[100%] max-w-7xl justify-center">

        <div class="mt-6 mb-6 flex justify-between px-4 min-[1281px]:px-0 gap-6">

            <div>
                <h2 class="text-2xl font-bold text-gray-800 font-montserrat">Mensagens Recebidas</h2>
                <p class="text-sm text-gray-600">Gerencie os contatos enviados pelos visitantes do site Verve.</p>
            </div>



            <div class="flex flex-row text-black text-xs font-bold bg-[#d8bf9f] 
            justify-center items-center w-20 h-7 rounded-sm mt-1.5">
                <p>Total: {{messages.length}}</p>
            </div>

        </div>



        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 px-4 min-[1281px]:px-0">

            {{#each messages}}
            <div class="bg-white shadow-sm border border-gray-200 
                p-5 flex flex-col justify-between hover:shadow-md transition-shadow">

                <div>

                    <div class="border-b  border-gray-100 mb-3 flex flex-row  justify-between">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 mb-1">{{this.nome}}</h3>
                            <p class="text-sm text-[#93a06c] font-mono break-all">{{this.email}}</p>
                        </div>



                    </div>

                    <div class="text-gray-700 text-sm bg-gray-50 p-3 border border-gray-100 min-h-[100px] break-words">
                        <p class="whitespace-pre-line">{{this.msg}}</p>
                    </div>
                </div>

                <div class="my-4 pt-3 border-t border-gray-100 flex justify-between items-center text-xs text-gray-400">
                    <span>Enviado em:</span>
                    <span class="font-medium text-gray-500">{{this.createdAt}}</span>
                </div>

                <form action="/admin/dashboard/delete/{{this.id}}" method="post" class="">
                    <input type="submit" value="Excluir" 
                        class="w-full bg-[#93a06c] hover:bg-[#626e3e] text-white 
                        cursor-pointer flex item-end text-xs font-bold w-16 h-8 rounded-sm ">
                </form>



            </div>

            {{/each}}

            {{#unless messages}}
            <div class="col-span-full bg-yellow-50 border border-yellow-200 text-yellow-800 p-4 rounded-lg text-center">
                <p class="font-medium">Nenhuma mensagem encontrada no banco de dados até o momento.</p>
            </div>
            {{/unless}}

        </div>



    </div>
</div>